{
  "name": "deskcron",
  "version": "0.3.0",
  "description": "Local-first workflow automation for developers. Run shell, HTTP, Git, Ollama and notification workflows from YAML.",
  "type": "module",
  "bin": {
    "deskcron": "./dist/cli.js"
  },
  "files": [
    "dist",
    "recipes",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "UPGRADING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "automation",
    "cron",
    "workflow",
    "local-first",
    "developer-tools",
    "ollama",
    "scheduler",
    "cli"
  ],
  "author": "Dinicley Aguiar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinicleyaguiar/DeskCron.git"
  },
  "homepage": "https://github.com/dinicleyaguiar/DeskCron#readme",
  "bugs": {
    "url": "https://github.com/dinicleyaguiar/DeskCron/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "node-cron": "^4.6.0",
    "node-notifier": "^10.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-notifier": "^8.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
